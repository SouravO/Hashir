# Browser-safe Supabase settings. Replace with your project's URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BOOKING_ENABLED=false
VITE_LIVE_AVAILABILITY_ENABLED=false

# Server-only settings. Never put secret keys in VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_ENABLED=false

# Optional Gmail notifications (booking details to admin, status updates to customer).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MEET_INVITES_ENABLED=false
